{
  "expo": {
    "name": "ESpeak",
    "slug": "ESpeak",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/espeak-icon.png",
    "scheme": "espeak",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/espeak-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.wil.soriano.ESpeak"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/espeak-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/espeak-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
